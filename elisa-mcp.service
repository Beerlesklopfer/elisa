# =============================================================================
# ELISA – MCP-Server (SSE via uvicorn), hinter nginx unter /mcp/
#   Stellt die statischen PEP/REQ je Projekt read-only bereit (Bearer-Token).
# =============================================================================
[Unit]
Description=ELISA MCP-SSE-Server
After=network.target elisa.service elisa-ollama.service
Wants=elisa-ollama.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/usr/share/elisa
EnvironmentFile=/etc/elisa/env
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8765
ExecStart=/usr/share/elisa/.venv/bin/python -m mcp_server.server
Restart=on-failure
RestartSec=5s

ProtectSystem=strict
ReadWritePaths=/var/lib/elisa /var/log/elisa
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
